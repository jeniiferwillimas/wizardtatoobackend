{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "TattooNest",
    "Audience": "TattooNestApp"
  },
  "Crypto": {
    "WalletAddress": "${CRYPTO_WALLET_ADDRESS}"
  },
  "NowPayments": {
    "ApiKey": "${NOWPAYMENTS_API_KEY}",
    "IpnSecret": "${NOWPAYMENTS_IPN_SECRET}",
    "BaseUrl": "https://api.nowpayments.io/v1",
    "PriceCurrency": "usd"
  },
  "CardRamp": {
    "AlchemyPayRampUrl": "https://ramp.alchemypay.org",
    "AlchemyPayMerchantWallet": "${CRYPTO_WALLET_ADDRESS}",
    "MoonPayRampUrl": "https://buy.moonpay.com",
    "TransakRampUrl": "https://transak.com/buy"
  },
  "Mail": {
    "Host": "${MAIL_HOST}",
    "Port": 587,
    "Username": "${MAIL_USERNAME}",
    "Password": "${MAIL_PASSWORD}",
    "FromAddress": "${MAIL_FROM_ADDRESS}",
    "FromName": "TattooNest",
    "NotifyEmail": "${MAIL_NOTIFY_EMAIL}"
  },
  "FrontendUrl": "${FRONTEND_URL}",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "${ALLOWED_HOSTS}"
}
